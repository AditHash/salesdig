{
  "name": "backend",
  "version": "1.0.0",
  "description": "Salesdig backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/assets dist/assets",
    "start": "node dist/server.js",
    "backfill:embeddings": "tsx src/scripts/backfill-embeddings.ts"
  },
